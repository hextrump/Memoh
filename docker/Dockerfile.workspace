# syntax=docker/dockerfile:1

# The workspace image is the bot runtime base. The Server only supplies the
# bridge binary; base tools (node, python, uv), display dependencies, and
# runtime scripts are immutable image content. Agent CLIs are not part of the
# image: the workspace dependency manager installs them into /data per bot.
# Upgrade and rollback ordering: docs/workspace-dependencies-upgrade.md.

FROM rust:1.90-alpine AS a11y-cli-builder
RUN apk add --no-cache musl-dev
WORKDIR /work
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/work/target \
    set -eux; \
    cargo build --release -p a11y-cli; \
    cp target/release/a11y-cli /out-a11y-cli

FROM debian:bookworm-slim AS toolkit-builder
ARG TARGETARCH
RUN apt-get update \
  && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    binutils \
    ca-certificates \
    wget \
    xz-utils \
  && rm -rf /var/lib/apt/lists/*
COPY docker/toolkit/install.sh docker/toolkit/install-wrappers.sh /tmp/memoh-toolkit/
COPY docker/toolkit/bin /tmp/memoh-toolkit/bin
RUN MEMOH_TOOLKIT_GLIBC_ONLY=1 \
    MEMOH_TOOLKIT_SKIP_DISPLAY=1 \
    /tmp/memoh-toolkit/install.sh /opt/memoh/toolkit "${TARGETARCH:-amd64}"
COPY --from=a11y-cli-builder /out-a11y-cli /opt/memoh/toolkit/display/bin/a11y-cli
RUN chmod 0755 /opt/memoh/toolkit/display/bin/a11y-cli

# Only the live ACP integration-test target needs a bridge baked into the
# image. Production workspace containers receive the current bridge from the
# Server as a read-only file mount.
FROM --platform=$BUILDPLATFORM golang:1.25-alpine AS bridge-builder
ARG TARGETARCH
WORKDIR /build
RUN apk add --no-cache git
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY . .
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH:-amd64} \
    go build -trimpath -ldflags "-s -w" -o /out/bridge ./cmd/bridge

# antmemo: fork of Ant-Browser (github.com/felinics/ant-browser, vendored as
# third_party/ant-browser) driving a fingerprint-chromium core, replacing the
# workspace's old plain Chromium/Chrome install. No fallback: this stage must
# succeed for the workspace image to build.
FROM golang:1.25-bookworm AS ant-browser-builder
ARG TARGETARCH
RUN apt-get update \
  && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    curl \
    git \
    gnupg \
    libayatana-appindicator3-dev \
    libgtk-3-dev \
    pkg-config \
    python3 \
    tar \
  && (apt-get install -y --no-install-recommends libwebkit2gtk-4.1-dev \
      || apt-get install -y --no-install-recommends libwebkit2gtk-4.0-dev) \
  && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
  && apt-get install -y --no-install-recommends nodejs \
  && rm -rf /var/lib/apt/lists/*
RUN go install github.com/wailsapp/wails/v2/cmd/wails@v2.12.0
WORKDIR /build
COPY third_party/ant-browser .
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/build/frontend/node_modules \
    set -eux; \
    if [ "${TARGETARCH:-amd64}" != "amd64" ]; then \
      echo "[ERROR] ant-chrome/fingerprint-chromium is amd64-only; refusing to silently build for ${TARGETARCH}" >&2; \
      exit 1; \
    fi; \
    (cd frontend && BROWSERSLIST_IGNORE_OLD_DATA=1 npm ci --prefer-offline --no-audit --no-fund && npm run build:clean); \
    rm -f build/bin/ant-chrome; \
    if pkg-config --exists webkit2gtk-4.0; then \
      WAILS_TAGS=""; \
    elif pkg-config --exists webkit2gtk-4.1; then \
      WAILS_TAGS="-tags webkit2_41"; \
    else \
      echo "[ERROR] missing WebKitGTK development package: webkit2gtk-4.0 or webkit2gtk-4.1" >&2; \
      exit 1; \
    fi; \
    wails build -s -platform linux/amd64 $WAILS_TAGS -o ant-chrome; \
    test -x build/bin/ant-chrome; \
    mkdir -p /out; \
    cp build/bin/ant-chrome /out/ant-chrome

# fingerprint-chromium (ungoogled-chromium fork, BSD-3-Clause) is the core
# ant-chrome drives. 148.0.7778.215 only ships a linux/amd64 tarball.
FROM debian:bookworm-slim AS fingerprint-chromium-fetcher
ARG TARGETARCH
ARG FINGERPRINT_CHROMIUM_VERSION=148.0.7778.215
ARG XRAY_VERSION=v26.3.27
RUN apt-get update \
  && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    ca-certificates curl unzip xz-utils \
  && rm -rf /var/lib/apt/lists/*
RUN set -eux; \
    if [ "${TARGETARCH:-amd64}" != "amd64" ]; then \
      echo "[ERROR] fingerprint-chromium ${FINGERPRINT_CHROMIUM_VERSION} has no Linux arm64 release; refusing to silently fall back to another browser" >&2; \
      exit 1; \
    fi; \
    mkdir -p /opt/memoh/toolkit/browser/chrome; \
    curl -fsSL -o /tmp/fingerprint-chromium.tar.xz \
      "https://github.com/adryfish/fingerprint-chromium/releases/download/${FINGERPRINT_CHROMIUM_VERSION}/ungoogled-chromium-${FINGERPRINT_CHROMIUM_VERSION}-1-x86_64_linux.tar.xz"; \
    tar -xJf /tmp/fingerprint-chromium.tar.xz -C /opt/memoh/toolkit/browser/chrome --strip-components=1; \
    rm -f /tmp/fingerprint-chromium.tar.xz; \
    test -x /opt/memoh/toolkit/browser/chrome/chrome
# Xray carries the browser's proxy (Chromium cannot authenticate to socks5/http proxies itself).
RUN set -eux; \
    mkdir -p /opt/memoh/toolkit/browser/xray; \
    curl -fsSL -o /tmp/xray.zip "https://github.com/XTLS/Xray-core/releases/download/${XRAY_VERSION}/Xray-linux-64.zip"; \
    unzip -q /tmp/xray.zip xray geoip.dat geosite.dat -d /opt/memoh/toolkit/browser/xray; \
    rm -f /tmp/xray.zip; \
    /opt/memoh/toolkit/browser/xray/xray version

FROM debian:bookworm-slim AS workspace
ARG MEMOH_APT_COMMAND_TIMEOUT=1200
ENV DEBIAN_FRONTEND=noninteractive \
    MEMOH_APT_COMMAND_TIMEOUT=${MEMOH_APT_COMMAND_TIMEOUT} \
    MEMOH_TOOLKIT_DIR=/opt/memoh/toolkit \
    PATH=/opt/memoh/toolkit/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
WORKDIR /data

COPY scripts/desktop-install.sh /tmp/memoh-desktop-install.sh
RUN set -eux; \
    progress() { :; }; \
    has_cmd() { command -v "$1" >/dev/null 2>&1; }; \
    . /tmp/memoh-desktop-install.sh; \
    export MEMOH_DISPLAY_INSTALL_ASSETS_GLOBAL=1; \
    install_debian; \
    apt_get install -y --no-install-recommends util-linux; \
    rm -rf /var/lib/apt/lists/* /root/.cache/memoh-display-themes /tmp/memoh-desktop-install.sh; \
    mkdir -p /data /tmp/.X11-unix /opt/memoh/scripts; \
    chmod 0755 /data; \
    chmod 1777 /tmp/.X11-unix

COPY --from=toolkit-builder /opt/memoh/toolkit /opt/memoh/toolkit
COPY --from=ant-browser-builder /out/ant-chrome /opt/memoh/toolkit/browser/bin/ant-chrome
COPY --from=fingerprint-chromium-fetcher /opt/memoh/toolkit/browser/chrome /opt/memoh/toolkit/browser/chrome
COPY --from=fingerprint-chromium-fetcher /opt/memoh/toolkit/browser/xray /opt/memoh/toolkit/browser/xray
RUN chmod 0755 /opt/memoh/toolkit/browser/bin/ant-chrome /opt/memoh/toolkit/browser/chrome/chrome /opt/memoh/toolkit/browser/xray/xray
COPY scripts/desktop-style.sh scripts/display-apply-style.sh scripts/display-prepare.sh /opt/memoh/scripts/
RUN printf '%s\n' 'export PATH="/opt/memoh/toolkit/bin:$PATH"' > /etc/profile.d/memoh-toolkit.sh \
  && chmod 0755 /opt/memoh/scripts/*.sh \
  && test -x /usr/bin/tini \
  && flock -n -E 75 /tmp/memoh-workspace-lock-check true \
  && rm -f /tmp/memoh-workspace-lock-check \
  && test -x /opt/memoh/toolkit/bin/node \
  && test -x /opt/memoh/toolkit/bin/python3 \
  && test -x /opt/memoh/toolkit/bin/uv \
  && test -x /opt/memoh/toolkit/display/bin/a11y-cli \
  && /bin/bash -lc 'node --version >/dev/null && npm --version >/dev/null'

# Standalone bridge-over-TCP image used only by live ACP tests.
FROM workspace AS toolkit-acp-bridge-live
COPY --from=bridge-builder /out/bridge /usr/local/bin/bridge
ENV BRIDGE_TCP_ADDR=:1455
EXPOSE 1455
ENTRYPOINT ["/usr/bin/tini", "-g", "--", "/usr/local/bin/bridge"]

# Keep the default build output equal to the production workspace target.
FROM workspace AS final
